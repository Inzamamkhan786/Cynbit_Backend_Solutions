# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=https://www.cynbit.in,http://localhost:3000

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cynbit_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cynbit_db
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=5000

# Redis Configuration (Distributed Rate Limiting & Outbox)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=cynbit:

# Security & Rate Limiting Thresholds
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SEC=60
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW_SEC=900
RATE_LIMIT_NEWSLETTER_MAX=5
RATE_LIMIT_NEWSLETTER_WINDOW_SEC=3600
RATE_LIMIT_CAREERS_MAX=10
RATE_LIMIT_CAREERS_WINDOW_SEC=1800

# Email Worker / Notification Mock
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=notifications@cynbit.in
EMAIL_MAX_RETRIES=3
